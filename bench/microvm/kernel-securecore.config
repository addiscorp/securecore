# What securecore's guest needs on top of mirab's guest-agent/kernel-x86_64.config
# (addiscorp/securecore#68): gelada inside the guest, for layer 3's isolated children (and for
# securecore-fpm, if layer 1's gelada step should also run inside the VM). gelada is Landlock
# (filesystem + TCP port rules, ABI 4+, which Linux 6.12 has) and seccomp filters; mirab's kernel
# has neither, so restrict_self fails in its guest.
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock"
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

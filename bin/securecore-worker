#!/bin/sh
# Launch the SecureCore worker with its isolation coming from the worker's own PHP settings,
# forced on the command line (-d) so the site's php.ini cannot loosen them: a disabled
# function stays disabled, and open_basedir can only be narrowed at runtime, never widened.
# This is the default, portable way to run the sandbox — it needs only PHP CLI with pcntl
# and opcache, no Docker. The systemd unit and the Docker Compose service (see INSTALL.md)
# add outer layers around this same command.
#
#   securecore-worker                       inside a site: everything from this file's location
#   securecore-worker <socket> <plugins-dir> <manifests-dir> [php-binary]
#
# With no arguments it assumes the standard layout it is installed in,
# wp-content/plugins/securecore/bin/, and uses wp-content/securecore/worker.sock (SecureCore's
# default socket), wp-content/plugins and wp-content/securecore/manifests.
set -eu
here=$(CDPATH='' cd "$(dirname "$0")" && pwd)
code=$(CDPATH='' cd "$here/../sandbox" && pwd)
content=$(CDPATH='' cd "$here/../../.." && pwd)
sock=${1:-$content/securecore/worker.sock}
plugins=${2:-$content/plugins}
manifests=${3:-$content/securecore/manifests}
# The PHP: the one given, else the project's worker PHP that install.sh chose or downloaded
# (<site>/.securecore/bin/php-worker) when it runs here, else `php`.
php=${4:-}
if [ -z "$php" ]; then
  php=php
  local_php=$(dirname "$content")/.securecore/bin/php-worker
  if [ -x "$local_php" ] && "$local_php" -v >/dev/null 2>&1; then php=$local_php; fi
fi
php=$(command -v "$php") || { echo "securecore-worker: no '$php' command found (needs PHP CLI with pcntl and opcache)" >&2; exit 1; }
sockdir=$(dirname "$sock")
mkdir -p "$manifests" "$sockdir"

# Unix socket paths are short (103 usable bytes on macOS, 107 on Linux).
max=103
[ "$(uname -s)" = Linux ] && max=107
if [ "${#sock}" -gt "$max" ]; then
  echo "securecore-worker: the socket path is ${#sock} characters, over the $max this system allows:" >&2
  echo "  $sock" >&2
  echo "Pass a shorter one as the first argument, e.g. /tmp/securecore.sock, and put the same path in" >&2
  echo "wp-config.php: define( 'SECURECORE_SOCKET', '/tmp/securecore.sock' );" >&2
  exit 1
fi

# One worker per socket: if one is already answering on it, starting another would take the
# socket away from it. A socket nobody answers on is left over from a stopped worker, and
# worker.php replaces it.
# shellcheck disable=SC2016 # PHP code: $argv is PHP's
if [ -S "$sock" ] && "$php" -r 'exit(@stream_socket_client("unix://" . $argv[1]) ? 0 : 1);' "$sock" 2>/dev/null; then
  echo "securecore-worker: a worker is already running on $sock; stop it first to start a new one" >&2
  exit 1
fi

# open_basedir: the worker's code, the plugins (its input), the manifests and the socket dir.
# wp-config.php and the rest of the site are outside it, so a sandboxed plugin cannot read
# them. In the "real WordPress" model (SECURECORE_REALWP, #42) the worker must also read the
# site's WordPress core, so the WordPress root is added — reading wp-config.php is then left
# to gelada to deny (a later part of #42; on this Docker spike the worker mounts it blocked).
# disable_functions: process execution, and every outbound-network call, so a plugin cannot
# shell out or open a connection. allow_url_fopen/include off for the same reason. env -i: a
# clean environment, so no host secrets leak in through getenv().
basedir="$code:$plugins:$manifests:$sockdir"
if [ -n "${SECURECORE_REALWP:-}" ]; then
  wproot=$(CDPATH='' cd "$content/.." && pwd)
  basedir="$basedir:$wproot"
fi
exec env -i PATH=/usr/bin:/bin:/usr/local/bin \
  ${SECURECORE_NOFORK:+SECURECORE_NOFORK="$SECURECORE_NOFORK"} \
  ${SECURECORE_REALWP:+SECURECORE_REALWP="$SECURECORE_REALWP"} \
  "$php" \
  -d open_basedir="$basedir" \
  -d disable_functions="exec,passthru,shell_exec,system,proc_open,proc_close,proc_get_status,proc_terminate,popen,pcntl_exec,fsockopen,pfsockopen,stream_socket_client,socket_create,socket_connect,socket_bind,curl_init,curl_exec,curl_multi_exec,mail" \
  -d allow_url_fopen=0 -d allow_url_include=0 \
  -d opcache.enable=1 -d opcache.enable_cli=1 -d opcache.validate_timestamps=0 \
  "$code/worker.php" "$sock" "$plugins" "$manifests"

{
  "layer1": {
    "enabled": true,
    "write": ["wp-content/uploads", "wp-content/cache", "/tmp"],
    "deny": ["/srv/backups"],
    "network": {
      "bind":    [{ "port": 9000 }],
      "connect": [{ "port": 53 }, { "port": 3306 }, { "port": 443 }]
    }
  },
  "layer2": {
    "enabled": true,
    "app": "wordpress",
    "mode": "enforce",
    "vault": {
      "from": { "wpConfig": "wp-config.php" },
      "secrets": [
        { "name": "DB_PASSWORD",      "env": "WORDPRESS_DB_PASSWORD" },
        { "name": "AUTH_KEY",         "env": "WORDPRESS_AUTH_KEY" },
        { "name": "SECURE_AUTH_KEY",  "env": "WORDPRESS_SECURE_AUTH_KEY" },
        { "name": "LOGGED_IN_KEY",    "env": "WORDPRESS_LOGGED_IN_KEY" },
        { "name": "NONCE_KEY",        "env": "WORDPRESS_NONCE_KEY" },
        { "name": "AUTH_SALT",        "env": "WORDPRESS_AUTH_SALT" },
        { "name": "SECURE_AUTH_SALT", "env": "WORDPRESS_SECURE_AUTH_SALT" },
        { "name": "LOGGED_IN_SALT",   "env": "WORDPRESS_LOGGED_IN_SALT" },
        { "name": "NONCE_SALT",       "env": "WORDPRESS_NONCE_SALT" }
      ]
    },
    "core": { "hosts": ["api.wordpress.org", "downloads.wordpress.org"] },
    "default": { "hosts": [], "tables": "own", "options": "own" },
    "components": {
      "contact-form-7": { "hosts": [], "files": { "write": ["wp-content/uploads/wpcf7_uploads"] } },
      "woocommerce": { "hosts": ["api.stripe.com"], "tables": ["wc_*", "woocommerce_*"], "grants": ["users:read"] },
      "wp-smushit": { "files": { "read": ["/usr/bin"] }, "exec": true }
    }
  },
  "layer3": {
    "enabled": true,
    "isolate": ["contact-form-7"],
    "limits": { "timeoutMs": 5000, "memoryMb": 256 },
    "write": { "contact-form-7": ["wp-content/uploads/wpcf7_uploads"] }
  }
}
